PORT=3001
NODE_ENV=development

# ── PostgreSQL via Supabase Pooler (conexión principal) ────────────────────────
# Host correcto verificado: aws-1-us-east-1.pooler.supabase.com
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# ── Supabase Client (opcional — para Storage u otras integraciones futuras) ────
# No es necesario para la API principal. Dejar vacío si no se usa.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
